<div id="<%= dom_id company %>">
  <div>
    <strong>Name:</strong>
    <%= company.name %>
  </div>

  <div>
    <strong>Industry:</strong>
    <%= company.industry %>
  </div>

  <div>
    <strong>Starting salary:</strong>
    <%= company.starting_salary %>
  </div>

  <div>
    <strong>Url:</strong>
    <%= company.url %>
  </div>

  <div>
    <strong>Description:</strong>
    <%= company.description %>
  </div>

</div>
