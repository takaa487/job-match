<%= form_with(model: company, data: { turbo: false }) do |form| %>
  <% if company.errors.any? %>
    <div class="alert alert-danger">
      <h2 class="h6">保存できませんでした。次の点を直してください。</h2>
      <ul class="mb-0">
        <% company.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, class: "form-label" %>
    <%= form.text_field :name, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :industry, class: "form-label" %>
    <%= form.text_field :industry, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :starting_salary, class: "form-label" %>
    <%= form.number_field :starting_salary, min: 0, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :work_location, class: "form-label" %>
    <%= form.text_field :work_location, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :url, class: "form-label" %>
    <%= form.url_field :url, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :description, class: "form-label" %>
    <%= form.text_area :description, rows: 4, class: "form-control" %>
  </div>

  <div>
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>