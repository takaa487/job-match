<% content_for :title, @company.name %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1><%= @company.name %></h1>
  <%= link_to "← 一覧に戻る", companies_path, class: "btn btn-outline-secondary btn-sm" %>
</div>

<div class="card mb-3">
  <div class="card-body">
    <%= render @company %>
  </div>
</div>

<% if current_user&.admin? %>
  <div class="mb-4">
    <%= link_to "編集", edit_company_path(@company), class: "btn btn-outline-primary btn-sm" %>
    <%= button_to "削除", @company, method: :delete, class: "btn btn-outline-danger btn-sm", form: { class: "d-inline" }, data: { turbo_confirm: "この企業を削除しますか？" } %>
  </div>
<% end %>

<div class="card border-primary">
  <div class="card-body">
    <h2 class="h5">この企業向けのES下書きを作る</h2>
    <p class="text-muted">AIがこの企業をWebで調べてから、志望動機の下書きを作ります。</p>
    <%= link_to "ES下書きを作る", new_es_generation_path(company_name: @company.name), class: "btn btn-primary" %>
  </div>
</div>
