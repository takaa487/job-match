<!DOCTYPE html>
<html lang="ja">
  <head>
    <title><%= content_for(:title) || "就活タイプ診断" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="就活タイプ診断">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@400;700;800&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="navbar navbar-expand-md app-navbar mb-3">
      <div class="container">
        <%= link_to "就活タイプ診断", root_path, class: "navbar-brand app-brand" %>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#appMenu" aria-controls="appMenu" aria-expanded="false" aria-label="メニューを開く">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="appMenu">
          <ul class="navbar-nav ms-auto align-items-md-center gap-md-2">
            <li class="nav-item"><%= link_to "タイプ診断", new_diagnosis_path, class: "nav-link" %></li>
            <li class="nav-item"><%= link_to "企業を探す", companies_path, class: "nav-link" %></li>
            <li class="nav-item"><%= link_to "ES作成", new_es_generation_path, class: "nav-link" %></li>
            <% if user_signed_in? %>
              <li class="nav-item"><%= link_to "保存したES", es_drafts_path, class: "nav-link" %></li>
              <li class="nav-item"><%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "btn btn-outline-primary btn-sm", form: { class: "d-inline" } %></li>
            <% else %>
              <li class="nav-item"><%= link_to "ログイン", new_user_session_path, class: "nav-link" %></li>
              <li class="nav-item"><%= link_to "新規登録", new_user_registration_path, class: "btn btn-primary btn-sm px-3" %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </nav>

    <main class="container pb-5">
      <% unless current_page?(root_path) %>
        <a href="<%= root_path %>" class="d-inline-block small fw-bold text-decoration-none mb-2" data-turbo="false" onclick="if (history.length > 1) { history.back(); return false; }">← 戻る</a>
      <% end %>
      <% if notice %>
        <div class="alert alert-success"><%= notice %></div>
      <% end %>
      <% if alert %>
        <div class="alert alert-warning"><%= alert %></div>
      <% end %>

      <%= yield %>
    </main>

    <footer class="container pb-4 small text-center">
      <%= link_to "プライバシーポリシー", privacy_path, class: "text-secondary" %>
    </footer>
  </body>
</html>
