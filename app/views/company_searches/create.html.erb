<div class="container py-4" style="max-width: 900px;">
  <h1 class="h3 mb-2">AIが探した会社</h1>
  <p class="text-muted mb-4">
    業界：<%= @industries.join("・") %> ／ 勤務地：<%= @areas.any? ? @areas.join("・") : "指定なし" %> ／ 初任給：<%= @min_salary.positive? ? "#{@min_salary / 10_000}万円以上" : "指定なし" %>
  </p>

  <% if @companies.empty? %>
    <div class="alert alert-warning">条件に合う会社をうまく見つけられませんでした。条件を変えて、もう一度試してください。</div>
  <% end %>

  <% @companies.each do |company| %>
    <div class="card mb-3">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start gap-3">
          <div>
            <h2 class="h5 mb-1"><%= company[:name] %></h2>
            <div class="small text-muted"><%= company[:industry] %></div>
            <div class="small mt-1 mb-2">勤務地：<%= company[:work_location] %></div>
          </div>
          <div class="text-end text-nowrap">
            <div class="small text-muted">初任給（月給）</div>
            <div class="fw-bold"><%= company[:salary] %></div>
          </div>
        </div>
        <p class="mb-3"><%= company[:summary] %></p>
        <div class="d-flex flex-wrap gap-2">
          <%= link_to "この会社のES下書きを作る", new_es_generation_path(company_name: company[:name]), class: "btn btn-primary btn-sm" %>
          <% if company[:source_url] %>
            <%= link_to "出典を開く", company[:source_url], target: "_blank", rel: "noopener", class: "btn btn-outline-secondary btn-sm" %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <% if @sources.any? %>
    <h2 class="h6 mt-4">AIが参考にしたページ</h2>
    <ul class="small">
      <% @sources.each do |source| %>
        <li><%= link_to source[:title].presence || source[:url], source[:url], target: "_blank", rel: "noopener" %></li>
      <% end %>
    </ul>
  <% end %>

  <p class="small text-muted mt-3">AIがWeb検索で調べた内容なので、間違っていることがあります。初任給や勤務地などは、必ず出典や会社の公式ページで確かめてください。この結果は保存されません。</p>

  <%= link_to "絞り込みに戻る", filter_companies_path(industries: @industries, areas: @areas, min_salary: params[:min_salary]), class: "btn btn-link px-0" %>
</div>