<% content_for :title, "保存したES" %>

<h1 class="mb-4">保存したES</h1>

<% if @es_drafts.empty? %>
  <p class="text-muted">まだ保存したESはありません。</p>
<% else %>
  <% @es_drafts.each do |draft| %>
    <div class="card mb-3">
      <div class="card-body">
        <h5 class="card-title"><%= draft.company.name %></h5>
        <p class="text-muted mb-2"><small><%= draft.created_at.strftime("%Y/%m/%d %H:%M") %> 保存</small></p>
        <div class="border rounded p-3 bg-light" style="white-space: pre-wrap;"><%= draft.content %></div>
        <%= button_to "削除", es_draft_path(draft), method: :delete, class: "btn btn-outline-danger btn-sm mt-2", form: { class: "d-inline" }, data: { turbo_confirm: "このESを削除しますか？" } %>
      </div>
    </div>
  <% end %>
<% end %>